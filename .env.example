# Required for every API request outside local development.
CHRONICLE_API_TOKEN=replace-with-a-long-random-token

# LLM provider seam: "ollama" (local, default) or "openai" for any
# OpenAI-compatible hosted endpoint (OpenRouter, Groq, or Google Gemini).
# To use a hosted provider, set LLM_PROVIDER=openai and the OPENAI_* variables
# below. Copy this file to .env and fill in your values.
#
# Endpoints are tried in order with automatic failover: when one rate-limits,
# rejects the key, or 5xxes, it is blacked out for a cooldown and the next one
# takes over. Add more fallbacks with OPENAI_BASE_URL_3/OPENAI_API_KEY_3/
# OPENAI_CHAT_MODEL_3 (up to _9), each with an optional OPENAI_MAX_TOKENS_N.
#
#   OpenRouter (free tier, many :free models; pick one that supports
#   json_schema structured output):
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1
#     OPENAI_API_KEY=sk-or-...
#     OPENAI_CHAT_MODEL=openai/gpt-oss-20b:free
#
#   Google Gemini (free tier via AI Studio; note: free-tier prompts may be used
#   for training). Use the OpenAI-compatible layer with your AI Studio key:
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENAI_API_KEY=<ai-studio-key>
#     OPENAI_CHAT_MODEL=gemini-flash-latest
#
#   Groq (free tier, fast, does not train on your data):
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_API_KEY=<groq-key>
#     OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
#
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=nemotron-mini:latest
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_BASE_URL_2=
OPENAI_API_KEY_2=
OPENAI_CHAT_MODEL_2=
# Completion-token budget for the hosted OpenAI-compatible provider. The 2048
# CPU-oriented ceiling in EXTRACTION_MAX_TOKENS is too small for free hosted
# models (they over-extract and the response truncates mid-JSON, failing schema
# validation). 8192 is well under Gemini's 32k completion cap.
OPENAI_MAX_TOKENS=8192

# Phase 1 safety limits.
MAX_REPORT_BYTES=10485760
URL_FETCH_TIMEOUT_MS=15000
MAX_REDIRECTS=3

# Extraction tuning (right-sized for CPU-only nemotron-mini inference; measured
# 2026-08-06: qwen2.5:3b missed all malware/IOCs, nemotron extracts them).
# Keep chunk sizes small; per-call timeout must stay under Ollama's ~5 min server cap.
LLM_TIMEOUT_MS=600000
EXTRACTION_MAX_CHUNK_CHARS=2100
EXTRACTION_MAX_TOKENS=2048
# "schema" (JSON-schema constrained, recommended) or "json" (loose; small local
# models tend to emit their own schema in loose mode).
EXTRACTION_FORMAT=schema

# Phase 2 persistence. Postgres (Docker): docker run -d --name chronicle-postgres \
#   -e POSTGRES_USER=chronicle -e POSTGRES_PASSWORD=replace-with-a-password \
#   -e POSTGRES_DB=chronicle -p 127.0.0.1:5432:5432 postgres:17-alpine
# Switch the report store to Postgres with REPORT_STORE_BACKEND=postgres.
# For a remote database, append the TLS options to the URL, e.g.
#   postgresql://dbuser:__VG_PASSWORD_PLACEHOLDER__:5432/chronicle?sslmode=require
REPORT_STORE_BACKEND=memory
DATABASE_URL=postgresql://chronicle:replace-with-a-password@127.0.0.1:5432/chronicle # gitleaks:allow — documented placeholder

# Durable job queue. Redis (Docker): docker run -d --name chronicle-redis \
#   -p 127.0.0.1:6379:6379 -v chronicle-redisdata:/data redis:7-alpine
# With JOB_QUEUE_BACKEND=redis the app only enqueues; run `npm run worker` in a
# separate process to consume the queue (jobs survive app restarts in Redis).
JOB_QUEUE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Postman API key (https://postman.postman.co/settings/me/api-keys, PMAK-...).
# `npm run postman:sync` upserts postman/*.json into your workspace with it.
# POSTMAN_WORKSPACE_ID (optional) picks a workspace; defaults to the first.
POSTMAN_API_KEY=
# POSTMAN_WORKSPACE_ID=
