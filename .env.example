# Required for every API request outside local development.
CHRONICLE_API_TOKEN=replace-with-a-long-random-token

# LLM provider seam. Ollama is the only production provider in Phase 1.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Phase 1 safety limits.
MAX_REPORT_BYTES=10485760
URL_FETCH_TIMEOUT_MS=15000

# Extraction tuning (right-sized for CPU-only qwen2.5:3b inference).
# Keep chunk sizes small; per-call timeout must stay well under Ollama's ~5 min server cap.
LLM_TIMEOUT_MS=180000
EXTRACTION_MAX_CHUNK_CHARS=1200
# "schema" (JSON-schema constrained, recommended) or "json" (loose; qwen2.5:3b tends to emit its own schema).
EXTRACTION_FORMAT=schema
