{
  "name": "chronicle-threatgraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "start": "node scripts/serve.mjs",
    "worker": "tsx src/modules/processing/worker.ts",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "eval:golden": "tsx src/evaluation/run.ts",
    "attck:refresh": "tsx scripts/attck-refresh.ts",
    "postman:sync": "tsx --env-file=.env scripts/postman-sync.ts",
    "build:worker": "esbuild src/modules/processing/worker.ts --bundle --platform=node --format=cjs --outfile=.next/standalone/worker.cjs --alias:@=./src --external:@prisma/client --external:@prisma/adapter-pg --external:pg"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.7",
    "ioredis": "^6.0.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.0.0",
    "vis-network": "^10.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.6.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
